# ==========================================================
# Root-level environment file, read by docker-compose.yml.
# Copy to ".env" in the project root and fill in real values
# before running `docker-compose up`.
#
# For running the backend/frontend individually outside Docker,
# use backend/.env.example and frontend/.env.example instead —
# this file only feeds docker-compose's variable substitution.
# ==========================================================

DATABASE_URL=sqlite:///./patient_mobility.db

SECRET_KEY=change_this_to_a_long_random_secret_string
DEFAULT_ADMIN_EMAIL=admin@example.com
DEFAULT_ADMIN_PASSWORD=ChangeMe123!

FRONTEND_ORIGIN=http://localhost

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
ALERT_RECIPIENT_EMAIL=

TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Uncomment if enabling the optional postgres service in docker-compose.yml
# POSTGRES_DB=patient_mobility
# POSTGRES_USER=har_user
# POSTGRES_PASSWORD=change_this_too
