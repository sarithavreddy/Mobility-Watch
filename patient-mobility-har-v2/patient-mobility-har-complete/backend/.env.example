# ==========================================================
# Environment configuration template
# Copy this file to ".env" and fill in real values.
# Never commit the actual ".env" file to version control.
# ==========================================================

# --- Application ---
APP_NAME="Patient Mobility HAR System"
APP_ENV=development          # development | production
DEBUG=true

# --- Database ---
# SQLite (default, zero-setup):
DATABASE_URL=sqlite:///./patient_mobility.db
# Postgres (production-ready alternative, uncomment and configure):
# DATABASE_URL=postgresql://<user>:<password>@<host>:5432/<db_name>

# --- Authentication / JWT ---
SECRET_KEY=change_this_to_a_long_random_secret_string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Default admin account (seeded on first run if users table is empty) ---
DEFAULT_ADMIN_NAME="System Administrator"
DEFAULT_ADMIN_EMAIL=admin@example.com
DEFAULT_ADMIN_PASSWORD=ChangeMe123!

# --- CORS ---
FRONTEND_ORIGIN=http://localhost:5173

# --- File storage ---
UPLOAD_DIR=./uploads
MODELS_DIR=./models_store

# --- Camera defaults ---
DEFAULT_CAMERA_SOURCE=0        # 0 = default webcam index; or an RTSP/HTTP URL
CAMERA_TARGET_FPS=15

# --- Activity / fall / inactivity detection thresholds ---
FALL_TORSO_ANGLE_THRESHOLD_DEG=55
FALL_VERTICAL_VELOCITY_THRESHOLD=0.35
FALL_CONFIRMATION_WINDOW_SEC=5
INACTIVITY_THRESHOLD_SEC=60
ACTIVITY_CONFIDENCE_MIN=0.60

# --- Email notifications (SMTP) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM_NAME="Patient Monitoring Alerts"
ALERT_RECIPIENT_EMAIL=caregiver@example.com

# --- Telegram notifications (optional / bonus) ---
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- SMS / voice-call alerts (optional, real provider only — Twilio) ---
# Leave SMS_ENABLED=false (or leave the Twilio fields blank) to disable —
# the app never fakes a successful SMS/call. Requires `pip install twilio`.
SMS_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
SMS_CALL_ON_CRITICAL_ALERT=false

# --- Logging ---
LOG_LEVEL=INFO
LOG_FILE=./logs/app.log
